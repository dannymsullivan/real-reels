---
import { site, money, fromPrice } from '../config/site';
---
<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-ink text-ivory" aria-label="Introduction">
  <!-- Poster always present (shown when video can't / shouldn't play) -->
  <img src="/media/hero-poster.jpg" alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" decoding="async" />
  <video id="hero-video" class="absolute inset-0 -z-10 h-full w-full object-cover motion-reduce:hidden"
    autoplay muted loop playsinline preload="metadata" poster="/media/hero-poster.jpg" aria-hidden="true" tabindex="-1">
    <!-- Small screens get a ~1 MB 960px cut; desktop keeps 1080p. Data-saver is handled below. -->
    <source src="/media/hero-960.webm" type="video/webm" media="(max-width: 767px)" data-light />
    <source src="/media/hero-960.mp4" type="video/mp4" media="(max-width: 767px)" data-light />
    <source src="/media/hero.webm" type="video/webm" />
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>
  <script is:inline>
    (function () {
      var v = document.getElementById('hero-video');
      if (!v || !(navigator.connection && navigator.connection.saveData)) return;
      v.querySelectorAll('source:not([data-light])').forEach(function (s) { s.remove(); });
      v.querySelectorAll('source[data-light]').forEach(function (s) { s.removeAttribute('media'); });
      v.load();
    })();
  </script>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/50 max-sm:via-ink/55"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/80 via-ink/45 to-transparent max-sm:from-ink/55 max-sm:via-ink/40 max-sm:to-ink/20"></div>

  <!-- Camcorder viewfinder overlay -->
  <div class="pointer-events-none absolute inset-4 sm:inset-8 top-24 sm:top-28 font-mono text-[11px] sm:text-xs tracking-[0.2em] text-ivory/85" aria-hidden="true">
    <span class="absolute left-0 top-0 h-6 w-6 border-l border-t border-ivory/70"></span>
    <span class="absolute right-0 top-0 h-6 w-6 border-r border-t border-ivory/70"></span>
    <span class="absolute bottom-0 left-0 h-6 w-6 border-b border-l border-ivory/70"></span>
    <span class="absolute bottom-0 right-0 h-6 w-6 border-b border-r border-ivory/70"></span>
    <span class="absolute left-5 top-4 flex items-center gap-2"><span class="rec-dot h-2.5 w-2.5 rounded-full bg-rec"></span>REC</span>
    <span class="absolute right-5 top-4 flex items-center gap-3">HD
      <svg class="h-3.5 w-7" viewBox="0 0 28 14" fill="none" stroke="currentColor"><rect x=".5" y=".5" width="24" height="13" rx="2"/><rect x="3" y="3" width="15" height="8" fill="currentColor" stroke="none"/><path d="M26.5 5v4"/></svg>
    </span>
    <span id="timecode" class="absolute bottom-4 left-16 hidden sm:block">00:00:00:00</span>
  </div>

  <div class="wrap relative pb-20 sm:pb-24 pt-40 [text-shadow:0_1px_18px_rgb(20_14_12/0.45)]">
    <p class="eyebrow !text-blush reveal">The guest-filmed wedding video</p>
    <h1 class="reveal mt-5 max-w-4xl text-[clamp(2.7rem,7.2vw,6.4rem)] font-light leading-[0.98]" style="--d:120ms">
      Say “I do.”<br /><em class="font-normal italic text-blush">Let everyone else film it.</em>
    </h1>
    <p class="reveal mt-6 max-w-xl text-lg text-ivory/85 sm:text-xl" style="--d:240ms">
      We ship a real HD camcorder kit. Your guests film all weekend. We edit the film you'll rewatch forever.
    </p>
    <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--d:360ms">
      <a href="#packages" class="btn btn-light">See the packages</a>
      <a href="#how" class="btn btn-ghost text-ivory">How it works</a>
    </div>
    <p class="reveal mt-8 text-sm text-ivory/70" style="--d:480ms">
      From <strong class="font-semibold text-ivory">{money(fromPrice)}</strong> · Free shipping anywhere in the US
    </p>
  </div>

  <button id="video-toggle" class="absolute bottom-8 left-8 z-10 hidden rounded-full border border-ivory/40 bg-ink/30 p-2.5 text-ivory backdrop-blur-sm transition hover:bg-ink/50 sm:bottom-10 sm:left-10 motion-safe:block" aria-label="Pause background video">
    <svg data-icon="pause" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
    <svg data-icon="play" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5v14l12-7z"/></svg>
  </button>
</section>
<script>
  const v = document.getElementById('hero-video') as HTMLVideoElement | null;
  const btn = document.getElementById('video-toggle');
  const tc = document.getElementById('timecode');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (v) {
    if (reduce.matches) { v.pause(); v.removeAttribute('autoplay'); }
    btn?.addEventListener('click', () => {
      const paused = v.paused;
      paused ? v.play() : v.pause();
      btn.setAttribute('aria-label', paused ? 'Pause background video' : 'Play background video');
      btn.querySelector('[data-icon=pause]')!.classList.toggle('hidden', !paused);
      btn.querySelector('[data-icon=play]')!.classList.toggle('hidden', paused);
    });
  }
  if (tc && !reduce.matches) {
    const start = performance.now();
    const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
    const tick = (t: number) => {
      const s = (t - start) / 1000 + 14 * 3600 + 32 * 60; // 2:32 PM, ceremony o'clock
      tc.textContent = `${pad(s / 3600 % 24)}:${pad(s / 60 % 60)}:${pad(s % 60)}:${pad((s % 1) * 25)}`;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
