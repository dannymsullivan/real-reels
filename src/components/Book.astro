---
import Icon from './Icon.astro';
import { site, money } from '../config/site';
---
<section id="book" class="relative isolate overflow-hidden bg-ink text-ivory">
  <img src="/media/couple-watching-film.jpg" alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-50" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-ink/90 via-ink/70 to-rose-deep/50"></div>
  <div class="wrap section grid items-center gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
    <div>
      <p class="eyebrow !text-blush reveal">Book your date</p>
      <h2 class="reveal mt-4 text-[clamp(2.6rem,6vw,5.2rem)] font-light leading-[0.98]" style="--d:100ms">Hand them the camera. <em class="italic text-blush">Keep the feeling.</em></h2>
      <ul class="reveal mt-8 space-y-3 text-ivory/85" style="--d:200ms">
        <li class="flex items-center gap-3"><Icon name="calendar" class="h-5 w-5 text-blush" />Dates book up fast in peak season</li>
        <li class="flex items-center gap-3"><Icon name="truck" class="h-5 w-5 text-blush" />Free shipping both ways, anywhere in the US</li>
        <li class="flex items-center gap-3"><Icon name="heart" class="h-5 w-5 text-blush" />A real human replies within one business day</li>
      </ul>
    </div>

    <form id="book-form" class="reveal rounded-[2rem] bg-ivory p-6 text-ink shadow-2xl sm:p-9" style="--d:150ms"
      name={site.form.name} method="POST" action="/?booked=1#book" data-netlify="true" netlify-honeypot="bot-field" data-success={site.form.successMessage}>
      <input type="hidden" name="form-name" value={site.form.name} />
      <p class="hidden" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div id="book-fields">
      <fieldset>
        <legend class="font-display text-2xl">Choose your box</legend>
        <div class={`mt-4 grid gap-2 sm:gap-3 ${site.packages.length >= 3 ? "grid-cols-3" : "grid-cols-2"}`}>
          {site.packages.map((p, i) => (
            <label class="relative cursor-pointer rounded-2xl border border-ink/15 p-3 sm:p-4 transition has-[:checked]:border-ink has-[:checked]:bg-cream has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-rose">
              <input type="radio" name="package" value={p.name} class="peer sr-only" checked={p.popular} required />
              <span class="flex gap-0.5 pr-6 text-ink/80" aria-hidden="true">{Array.from({ length: p.cameras }).map(() => <Icon name="camcorder" class="h-4 w-4 sm:h-5 sm:w-5" />)}</span>
              <span class="mt-2 block font-display text-base sm:text-xl">{p.name}</span>
              <span class="text-xs sm:text-sm text-cocoa/75">{money(p.price)}</span>{p.popular && <span class="mt-1 block text-[9px] font-semibold uppercase tracking-[0.15em] text-rose-deep">Most popular</span>}
              <span class="absolute right-2.5 top-2.5 grid h-5 w-5 place-items-center rounded-full border border-ink/25 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-ivory" aria-hidden="true"><Icon name="check" class="h-3 w-3" /></span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium">Your names
          <input name="names" autocomplete="name" required placeholder="Alex & Jordan" class="mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition focus:border-ink" />
        </label>
        <label class="block text-sm font-medium">Email
          <input name="email" type="email" autocomplete="email" required placeholder="you@example.com" class="mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition focus:border-ink" />
        </label>
        <label class="block text-sm font-medium">Wedding date
          <input name="date" type="date" required class="mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition focus:border-ink" />
        </label>
        <label class="block text-sm font-medium">Venue city & state <span class="font-normal text-cocoa/60">(optional)</span>
          <input name="venue" autocomplete="address-level2" placeholder="Asheville, NC" class="mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition focus:border-ink" />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">Anything we should know? <span class="font-normal text-cocoa/60">(optional)</span>
          <textarea name="message" rows="3" placeholder="Venue, guest count, a multi-day celebration…" class="mt-1.5 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition focus:border-ink"></textarea>
        </label>
      </div>
      <button type="submit" class="btn btn-primary mt-7 w-full disabled:opacity-60">Check my date <Icon name="arrow" class="h-4 w-4" /></button>
      <p class="mt-3 text-center text-xs text-cocoa/60">No payment yet. We'll confirm availability first.</p>
      <p id="book-error" class="mt-3 hidden rounded-xl bg-rose/15 p-3 text-center text-sm" role="alert"></p>
      </div>
      <div id="book-success" class="hidden py-10 text-center" role="status" tabindex="-1">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-sage/20 text-ink"><Icon name="check" class="h-7 w-7" /></span>
        <p class="mt-5 font-display text-3xl">You're on our list.</p>
        <p class="mx-auto mt-3 max-w-sm text-cocoa/80">{site.form.successMessage}</p>
      </div>
    </form>
  </div>
</section>
<script>
  const form = document.getElementById('book-form') as HTMLFormElement | null;
  // Pre-select a package when a "Book <tier>" button is clicked
  document.querySelectorAll<HTMLAnchorElement>('a[data-package]').forEach((a) =>
    a.addEventListener('click', () => {
      const name = a.dataset.packageName;
      const input = form?.querySelector<HTMLInputElement>(`input[name=package][value="${name}"]`);
      if (input) input.checked = true;
    }));
  const fields = document.getElementById('book-fields');
  const success = document.getElementById('book-success');
  const err = document.getElementById('book-error');
  const showSuccess = () => { fields?.classList.add('hidden'); success?.classList.remove('hidden'); success?.focus(); };
  if (new URLSearchParams(location.search).has('booked')) showSuccess(); // no-JS fallback redirect
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (btn) btn.disabled = true;
      err?.classList.add('hidden');
      try {
        const body = new URLSearchParams(new FormData(form) as any).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        showSuccess();
      } catch {
        if (err) { err.textContent = 'Sorry, that didn\u2019t send. Please try again in a moment.'; err.classList.remove('hidden'); }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
