---
import { site } from '../config/site';
const r = site.rental;
const steps = [
  { n: '01', title: 'Book your date', when: 'Anytime before', img: 'booking.jpg', alt: 'Couple booking their date on a laptop at the kitchen table', text: 'Pick a package. Your date is held.' },
  { n: '02', title: 'The box arrives', when: `${r.arrivesDaysBefore} days before`, img: 'kit-unboxing.jpg', alt: 'Couple on the living-room floor opening their camcorder kit, delighted', text: 'Charged, formatted, ready to roll.' },
  { n: '03', title: 'Guests film', when: 'Wedding weekend', img: 'guests-filming-reception.jpg', alt: 'A guest filming her friends at a candlelit reception table', text: 'Pass it around. Rehearsal to brunch.' },
  { n: '04', title: 'Ship it back', when: `Within ${r.returnWithinHours} hrs`, img: 'ship-back.jpg', alt: 'Hands packing the camcorder into the open box, with a blank label and tape beside it', text: `Prepaid ${r.carrier} label. Drop it off.` },
  { n: '05', title: 'We edit', when: `~${r.deliveryWeeks} weeks`, img: 'editing-suite.jpg', alt: 'Editor cutting a couple’s wedding film on a large monitor', text: 'Every clip sorted. The best ones cut to music.' },
  { n: '06', title: 'Relive forever', when: 'Every anniversary', img: 'couple-watching-film.jpg', alt: 'Couple on the sofa, moved to tears watching their wedding film on TV', text: 'Your film and every raw clip, yours to keep.' },
];
---
<section id="how" class="section bg-cream/70 overflow-hidden">
  <div class="wrap">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow reveal">How it works</p>
        <h2 class="reveal mt-4 text-[clamp(2.2rem,4.6vw,3.9rem)] font-light leading-[1.04]" style="--d:100ms">Six steps. <em class="italic text-rose-deep">Zero stress.</em></h2>
      </div>
      <p class="reveal max-w-sm text-cocoa/80" style="--d:200ms">Nothing to set up, nothing to learn. If your guests can press a red button, you're covered.</p>
    </div>
  </div>

  <div class="relative mt-14">
    <!-- timeline rail (desktop) -->
    <div class="wrap relative hidden lg:block" aria-hidden="true">
      <div class="absolute left-0 right-0 top-[7px] border-t border-dashed border-cocoa/30"></div>
    </div>
    <ol class="scrollbar-none wrap flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-6 lg:gap-5 lg:overflow-visible lg:pb-0">
      {steps.map((s, i) => (
        <li class="reveal group relative w-[72%] shrink-0 snap-start sm:w-[42%] lg:w-auto" style={`--d:${i * 90}ms`}>
          <div class="hidden lg:flex items-center gap-2 mb-5">
            <span class={`h-3.5 w-3.5 rounded-full border-2 border-cream ${i === 2 ? 'bg-rec' : 'bg-rose'}`}></span>
          </div>
          <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-rose-deep">{s.when}</p>
          <figure class="slot aspect-[4/5] rounded-2xl">
            <img src={`/media/${s.img}`} alt={s.alt} loading="lazy" decoding="async" width="1200" height="1500" />
            <span class="absolute left-3 top-3 rounded-full bg-ivory/90 px-2.5 py-1 font-mono text-[11px] text-ink">{s.n}</span>
          </figure>
          <h3 class="mt-4 font-display text-xl">{s.title}</h3>
          <p class="mt-1 text-sm text-cocoa/80">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
