---
// Alternating tall (4:5) / wide (3:2) order keeps the masonry columns balanced.
const shots = [
  { f: 'gallery-01.jpg', w: 1200, h: 1500, alt: 'A groom and his husband cry-laughing during the best man’s toast under a tent', cap: 'Filmed from the head table' },
  { f: 'gallery-02.jpg', w: 1800, h: 1200, alt: 'Bride and groom walking arm in arm through a golden-hour meadow', cap: 'Filmed by Uncle Rob' },
  { f: 'gallery-03.jpg', w: 1800, h: 1200, alt: 'Newlyweds running through a sparkler send-off while a guest films', cap: 'Filmed by the best man' },
  { f: 'gallery-04.jpg', w: 1200, h: 1500, alt: 'Grandparents slow dancing under string lights as guests applaud', cap: 'Filmed by a cousin, age 11' },
  { f: 'gallery-05.jpg', w: 1200, h: 1500, alt: 'Groom overcome with emotion at the first look in a garden', cap: 'Filmed by the maid of honor' },
  { f: 'gallery-06.jpg', w: 1800, h: 1200, alt: 'Friends laughing around a candlelit dinner table in a vineyard', cap: 'Filmed by table 6' },
  { f: 'gallery-07.jpg', w: 1800, h: 1200, alt: 'Close-up of a ring being slipped onto the bride’s finger, bouquet in hand', cap: 'Filmed from row two' },
  { f: 'gallery-08.jpg', w: 1200, h: 1500, alt: 'Packed dance floor at night with a guest filming on the camcorder', cap: 'Filmed by everyone, at some point' },
];
---
<section id="gallery" class="section bg-ivory">
  <div class="wrap">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow reveal">Gallery</p>
        <h2 class="reveal mt-4 text-[clamp(2.2rem,4.6vw,3.9rem)] font-light leading-[1.04]" style="--d:100ms">Shot by guests. <em class="italic text-rose-deep">Cut by us.</em></h2>
      </div>
      <p class="reveal max-w-sm text-cocoa/80" style="--d:200ms">Warm, real, a little imperfect. The way your wedding actually felt.</p>
    </div>
    <div class="mt-12 columns-2 gap-3 sm:gap-4 lg:columns-4 [&>figure]:mb-3 sm:[&>figure]:mb-4">
      {shots.map((s, i) => (
        <figure class="slot reveal group break-inside-avoid rounded-2xl" style={`--d:${(i % 4) * 80}ms`}>
          <img src={`/media/${s.f}`} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" class="h-auto" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent p-4 pt-10 text-xs text-ivory opacity-0 transition duration-500 group-hover:opacity-100 group-focus-within:opacity-100 max-sm:opacity-100 max-sm:text-[10px] max-sm:p-2.5 max-sm:pt-8">
            <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-rec align-middle"></span>{s.cap}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
