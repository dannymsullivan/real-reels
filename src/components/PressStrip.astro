---
import Icon from './Icon.astro';
// Trust strip. Swap in real press logos ("As featured in") once you have genuine features.
const points = [
  { icon: 'heart', label: 'Loved by couples across the US' },
  { icon: 'truck', label: 'Free shipping both ways' },
  { icon: 'raw', label: 'Every raw clip, yours to keep' },
  { icon: 'star', label: 'Cut to music, made to rewatch' },
];
---
<section class="border-b border-ink/10 bg-ivory py-6" aria-label="Why couples choose us">
  <ul class="wrap flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-sm text-cocoa/80">
    {points.map((p) => <li class="flex items-center gap-2"><Icon name={p.icon} class="h-4 w-4 text-rose-deep" />{p.label}</li>)}
  </ul>
</section>
