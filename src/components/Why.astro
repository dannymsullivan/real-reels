---
import Icon from './Icon.astro';
const points = [
  { icon: 'people', title: 'Every angle', text: 'Grandma’s table, the groomsmen’s huddle, the flower girl’s view.' },
  { icon: 'mic', title: 'Real voices', text: 'Toasts, whispered vows, the laugh you forgot. All with sound.' },
  { icon: 'eye', title: 'What you missed', text: 'Your day was a blur. Your guests caught all of it.' },
];
---
<section id="why" class="section bg-ivory">
  <div class="wrap grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
    <!-- Collage -->
    <div class="relative grid grid-cols-6 grid-rows-6 gap-3 sm:gap-4 aspect-[5/5.4]">
      <figure class="slot reveal col-span-4 row-span-4 rounded-[1.75rem] shadow-xl shadow-ink/10">
        <img src="/media/getting-ready.jpg" alt="Bridesmaids laughing while getting ready, filmed on a guest camcorder" loading="lazy" decoding="async" width="1200" height="1500" />
      </figure>
      <figure class="slot reveal col-span-2 col-start-5 row-span-3 row-start-2 rounded-[1.25rem]" style="--d:120ms">
        <img src="/media/ceremony.jpg" alt="Ceremony seen from the guests' rows" loading="lazy" decoding="async" width="1800" height="1200" />
      </figure>
      <figure class="slot reveal col-span-3 col-start-3 row-span-2 row-start-5 rounded-[1.25rem]" style="--d:240ms">
        <img src="/media/dance-floor.jpg" alt="Guests dancing under string lights" loading="lazy" decoding="async" width="1800" height="1200" />
      </figure>
      <div class="reveal col-span-2 row-span-2 row-start-5 flex flex-col justify-center rounded-[1.25rem] bg-ink p-4 text-ivory" style="--d:320ms">
        <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-[0.2em] text-ivory/70"><span class="rec-dot h-1.5 w-1.5 rounded-full bg-rec"></span>REC</span>
        <span class="mt-1 font-display text-3xl sm:text-4xl leading-none">100<span class="text-rose">+</span></span>
        <span class="text-xs text-ivory/70 leading-tight mt-1">guests behind the lens</span>
      </div>
    </div>

    <div>
      <p class="eyebrow reveal">Why guest-filmed</p>
      <h2 class="reveal mt-4 text-[clamp(2.2rem,4.6vw,3.9rem)] font-light leading-[1.04]" style="--d:100ms">
        One videographer sees one wedding. <em class="italic text-rose-deep">Your guests see yours.</em>
      </h2>

      <!-- 1 POV vs many POVs -->
      <div class="reveal mt-10 grid grid-cols-2 gap-3 sm:gap-4" style="--d:200ms" aria-label="One videographer gives one point of view; a camcorder passed between guests gives dozens.">
        <div class="rounded-2xl border border-ink/10 p-5">
          <div class="flex h-14 items-center"><Icon name="eye" class="h-7 w-7 text-cocoa/50" /></div>
          <p class="text-sm text-cocoa/70">1 hired crew</p>
          <p class="font-display text-2xl">1 point of view</p>
        </div>
        <div class="rounded-2xl bg-cream p-5">
          <div class="flex h-14 flex-wrap content-center gap-1" aria-hidden="true">
            {Array.from({ length: 24 }).map((_, i) => <span class="h-2.5 w-2.5 rounded-full" style={`background:${['#b27466','#8b937a','#b89260','#5b4339'][i % 4]};opacity:${0.55 + (i % 3) * 0.2}`}></span>)}
          </div>
          <p class="text-sm text-cocoa/70">Your whole guest list</p>
          <p class="font-display text-2xl">Every point of view</p>
        </div>
      </div>

      <ul class="mt-10 space-y-6">
        {points.map((p, i) => (
          <li class="reveal flex gap-4" style={`--d:${300 + i * 90}ms`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-blush/60 text-rose-deep"><Icon name={p.icon} class="h-5 w-5" /></span>
            <div><h3 class="font-display text-xl">{p.title}</h3><p class="text-cocoa/80">{p.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
