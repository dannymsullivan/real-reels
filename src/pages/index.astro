---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PressStrip from '../components/PressStrip.astro';
import Why from '../components/Why.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BandReel from '../components/BandReel.astro';
import Packages from '../components/Packages.astro';
import InTheBox from '../components/InTheBox.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <PressStrip />
    <Why />
    <HowItWorks />
    <BandReel />
    <Packages />
    <InTheBox />
    <Gallery />
    <Testimonials />
    <FAQ />
    <Book />
  </main>
  <Footer />
  <MobileBar />
</Base>
